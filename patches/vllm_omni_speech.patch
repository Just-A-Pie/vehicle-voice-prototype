     return payload
+
+
+def thinker2talker_async_chunk(
+    transfer_manager,
+    multimodal_output,
+    request,
+    is_finished: bool = False,
+) -> OmniPayloadStruct | None:
+    """Collect thinker hidden states and hand off its complete reply to Talker."""
+    request_id = request.external_req_id
+    state = transfer_manager.request_payload.setdefault(request_id, {"hidden_parts": []})
+    if isinstance(multimodal_output, dict):
+        hidden = multimodal_output.get("hidden")
+        if isinstance(hidden, torch.Tensor) and hidden.numel():
+            state["hidden_parts"].append(hidden.detach().cpu())
+    if not (is_finished or request.is_finished()):
+        return None
+    hidden_parts = state["hidden_parts"]
+    transfer_manager.request_payload.pop(request_id, None)
+    if not hidden_parts:
+        return None
+    payload = thinker2talker_full_payload(
+        transfer_manager,
+        {"hidden": torch.cat(hidden_parts)},
+        request,
+    )
+    if payload is None:
+        return None
+    return OmniPayloadStruct(
+        hidden_states=HiddenStatesStruct(**payload["hidden_states"]),
+        embed=EmbeddingsStruct(**payload["embed"]),
+        ids=IdsStruct(**payload["ids"]),
+        meta=MetaStruct(finished=torch.tensor(True, dtype=torch.bool)),
+    )
