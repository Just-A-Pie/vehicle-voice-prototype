+def talker2code2wav_async_chunk(
+    transfer_manager,
+    multimodal_output,
+    request,
+    is_finished: bool = False,
+) -> OmniPayloadStruct | None:
+    """Send cumulative codec ids when the next overlapping audio block is ready."""
+    del multimodal_output
+    request_id = request.external_req_id
+    finished = bool(is_finished or request.is_finished())
+    codec_ids = _strip_codec_boundaries(list(getattr(request, "output_token_ids", None) or []))
+    chunk_index = transfer_manager.put_req_chunk[request_id]
+    chunk_mel = 24 * int(os.environ.get("QWEN25_OMNI_MEL_CHUNK_BLOCKS", 12))
+    if chunk_mel <= 0:
+        raise ValueError("QWEN25_OMNI_MEL_CHUNK_BLOCKS must be positive")
+    chunk_codes = chunk_mel // 2
+    first_codes = (chunk_mel + 24) // 2
+    if not finished and len(codec_ids) < first_codes + chunk_codes * chunk_index:
+        return None
+    if not codec_ids and not finished:
+        return None
+    return OmniPayloadStruct(
+        codes=CodesStruct(audio=torch.tensor(codec_ids, dtype=torch.long).unsqueeze(0)),
+        meta=MetaStruct(
+            finished=torch.tensor(finished, dtype=torch.bool),
+            stream_finished=torch.tensor(finished, dtype=torch.bool),
+        ),
+        request_id=request_id,
+    )
+
+
 # ============================================================================
