# Legacy Qwen2.5 GPU/tunnel environment example.
# macOS demo setup instead uses config/demo.example.json -> runtime/demo-settings.json.
# Export these variables in your shell; Python does not automatically load .env.
VEHICLE_MODEL_PATH=/absolute/path/to/Qwen2.5-Omni-3B
VEHICLE_LOCAL_PORT=8770
VEHICLE_CONNECTION_FILE=/absolute/path/to/checkout/runtime/connection.json

# SSH proxy only; obtain access from the project owner, not from this repository.
VEHICLE_SSH_TARGET=your-user@your-gateway
VEHICLE_SSH_PORT=22
VEHICLE_REMOTE_ENDPOINT=/absolute/remote/checkout/runtime/endpoint.json
VEHICLE_TUNNEL_PORT=18841
# Optional, otherwise normal SSH agent/config authentication is used.
# VEHICLE_SSH_KEY=/absolute/path/to/your/private-key
