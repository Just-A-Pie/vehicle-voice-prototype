{
  "parameters": {
    "ac": {
      "type": "boolean",
      "label": "空调系统",
      "default": false
    },
    "climateMode": {
      "type": "string",
      "label": "空调模式：auto自动、cool制冷、heat制热、fan通风",
      "enum": [
        "auto",
        "cool",
        "heat",
        "fan"
      ],
      "default": "auto"
    },
    "temp": {
      "type": "number",
      "label": "设定温度",
      "min": 16,
      "max": 28,
      "step": 0.5,
      "default": 22,
      "unit": "°C"
    },
    "fan": {
      "type": "number",
      "label": "风量",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2,
      "unit": "档"
    },
    "frontAir": {
      "type": "boolean",
      "label": "前排送风",
      "default": true
    },
    "rearAir": {
      "type": "boolean",
      "label": "后排送风",
      "default": true
    },
    "playing": {
      "type": "boolean",
      "label": "音乐",
      "default": false
    },
    "volume": {
      "type": "number",
      "label": "音量",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.35,
      "unit": "%"
    },
    "muted": {
      "type": "boolean",
      "label": "静音",
      "default": false
    },
    "track": {
      "type": "number",
      "label": "曲目",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0,
      "unit": ""
    },
    "ambient": {
      "type": "boolean",
      "label": "氛围灯",
      "default": true
    },
    "ambientColor": {
      "type": "string",
      "label": "氛围灯颜色",
      "enum": [
        "blue",
        "violet",
        "amber"
      ],
      "default": "blue"
    },
    "ambientBrightness": {
      "type": "number",
      "label": "氛围灯亮度",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 70,
      "unit": "%"
    },
    "lights": {
      "type": "boolean",
      "label": "迎宾灯",
      "default": true
    },
    "locked": {
      "type": "boolean",
      "label": "车锁",
      "default": true
    },
    "leftDoor": {
      "type": "number",
      "label": "主驾车门开度",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "%"
    },
    "rightDoor": {
      "type": "number",
      "label": "副驾车门开度",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "%"
    },
    "rearLeftDoor": {
      "type": "number",
      "label": "左后车门开度",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "%"
    },
    "rearRightDoor": {
      "type": "number",
      "label": "右后车门开度",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "%"
